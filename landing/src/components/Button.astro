---
import type { HTMLAttributes } from "astro/types";

// Every button on the site — the pills, the icon squares in the nav, and the
// lightbox close. Geometry and states live here only, so two buttons can't
// drift apart. Renders an <a> when given an href, a <button> when given a
// type, and a <span> otherwise (the store listings that aren't live yet).
// An intersection rather than `extends`, and `type` re-declared as the button's
// own literal union — anchors type it as a plain string, which the two tags
// can't agree on.
type Props = Omit<HTMLAttributes<"a">, "type"> &
  Omit<HTMLAttributes<"button">, "type"> & {
    type?: HTMLAttributes<"button">["type"];
    href?: string;
    newTab?: boolean;
    variant?: keyof typeof variants;
    size?: keyof typeof sizes;
    class?: string;
  };

const sizes = {
  md: "rounded-full px-6 py-3",
  sm: "rounded-full px-5 py-2.5 text-sm",
  icon: "size-9 rounded-lg",
  "icon-lg": "size-10 rounded-lg",
};

const variants = {
  primary: "border-transparent bg-ink text-paper hover:bg-ink/90",
  secondary: "border-rule-2 hover:border-ink/40",
  /** Soft grey fill — reads on both themes, so it takes a literal rather than a token. */
  tinted: "border-transparent bg-[#aeaeae59] hover:bg-[#aeaeae80]",
  ghost: "border-transparent text-ink-2 hover:bg-surface hover:text-ink",
  /** For the icon squares that sit on the lightbox's dark backdrop. */
  overlay: "border-transparent text-white/80 hover:bg-white/10 hover:text-white",
};

const {
  href,
  newTab,
  variant = "secondary",
  size = "md",
  class: className = "",
  ...rest
} = Astro.props;

const Tag = href ? "a" : rest.type ? "button" : "span";
const external = newTab ?? (href?.startsWith("http") || false);
---

<Tag
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={[
    "inline-flex items-center justify-center gap-2 border font-semibold whitespace-nowrap transition-colors cursor-pointer",
    sizes[size],
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
