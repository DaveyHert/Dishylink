---
import Logo from "./Logo.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import SponsorMenu from "./SponsorMenu.astro";
import JobmateBanner from "./JobmateBanner.astro";
import { BLOG, GITHUB, X, PRIVACY, STARLINK_REFERRAL } from "../constants";

interface NavLink {
  label: string;
  href: string;
}

const links: (NavLink | { label: string; children: NavLink[] })[] = [
  { label: "Features", href: "/#features" },
  { label: "Reviews", href: "/#reviews" },
  { label: "Blog", href: BLOG },
  { label: "FAQ", href: "/#faq" },
  {
    label: "More",
    children: [
      { label: "Privacy", href: PRIVACY },
      { label: "Contribute", href: GITHUB },
    ],
  },
  { label: "Order Starlink", href: STARLINK_REFERRAL },
];
const flatLinks = links.flatMap((link) => ("children" in link ? link.children : [link]));

const newTab = (href: string) =>
  href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {};

const glassPanel =
  "overflow-hidden rounded-xl border border-rule/50 bg-[color-mix(in_srgb,var(--color-surface)_80%,transparent)] text-ink shadow-[0_12px_40px_rgb(0_0_0/0.28),inset_0_1px_0_rgb(255_255_255/0.08)] backdrop-blur-xl backdrop-saturate-150 dark:bg-[color-mix(in_srgb,#0e0e0e_80%,transparent)] dark:shadow-[0_12px_40px_rgb(0_0_0/0.45),inset_0_1px_0_rgb(255_255_255/0.08)]";

const socials = [
  { href: GITHUB, icon: "github", label: "Dishylink on GitHub" },
  { href: X, icon: "x", label: "@daveyhert on X" },
] as const;
---

<!-- The blur lives on a pseudo-element: backdrop-filter on the header itself
     would make it a backdrop root and flatten the sponsor menu's own blur. -->
<header
  class="sticky top-0 z-50 before:absolute before:inset-0 before:-z-10 before:bg-paper/85 before:backdrop-blur-md"
>
  <JobmateBanner />
  <nav
    class="mx-auto flex h-14 max-w-7xl items-center gap-6 px-5"
    aria-label="Primary"
  >
    <a href="/" class="flex items-center gap-2 text-xl font-semibold tracking-tight">
      <Logo class="size-10" />
      Dishylink
    </a>

    <ul class="ml-4 hidden items-center gap-6 text-sm text-ink-2 md:flex">
      {
        links.map((link) => (
          <li>
            {"children" in link ? (
              <details data-menu class="group relative">
                <summary class="flex cursor-pointer list-none items-center gap-1 transition-colors hover:text-ink [&::-webkit-details-marker]:hidden">
                  {link.label}
                  <Icon name="caret" class="size-3.5 transition-transform group-open:rotate-180" />
                </summary>
                <ul class:list={["absolute left-0 z-50 mt-2 w-40 p-1.5", glassPanel]}>
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        {...newTab(child.href)}
                        class="flex rounded-[8px] px-2 py-2 text-[13px] transition-colors hover:bg-rule/40"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                href={link.href}
                {...newTab(link.href)}
                class="cursor-pointer transition-colors hover:text-ink"
              >
                {link.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-1.5">
      <SponsorMenu />

      <Button
        id="theme-toggle"
        type="button"
        aria-label="Toggle colour theme"
        variant="ghost"
        size="icon"
      >
        <svg viewBox="0 0 24 24" class="size-4.5" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M12 3v1.5M12 19.5V21M3 12h1.5M19.5 12H21M5.6 5.6l1.1 1.1M17.3 17.3l1.1 1.1M18.4 5.6l-1.1 1.1M6.7 17.3l-1.1 1.1" stroke-linecap="round"></path>
          <circle cx="12" cy="12" r="4"></circle>
        </svg>
      </Button>

      {
        socials.map((social) => (
          <Button href={social.href} variant="ghost" size="icon" aria-label={social.label}>
            <Icon name={social.icon} class="size-4.5" />
          </Button>
        ))
      }

      {/* No `relative` here: the panel hangs from the sticky header, so it clears the banner too. */}
      <details data-menu class="md:hidden">
        <summary
          aria-label="Menu"
          class="grid size-9 cursor-pointer list-none place-items-center rounded-lg text-ink-2 transition-colors hover:bg-surface hover:text-ink [&::-webkit-details-marker]:hidden"
        >
          <Icon name="menu" class="size-4.5" />
        </summary>
        <ul class:list={["absolute inset-x-3 top-full z-50 mt-1 p-1.5", glassPanel]}>
          {
            flatLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...newTab(link.href)}
                  class="flex rounded-[8px] px-3 py-2.5 text-[15px] transition-colors hover:bg-rule/40"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>("details[data-menu]");

  // <details> neither closes on click-away nor on following one of its own links;
  // an in-page link like /#reviews never reloads, so it would stay open over the section.
  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    for (const menu of menus) {
      if (!menu.contains(target) || target.closest("a")) menu.open = false;
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const menu of menus) menu.open = false;
  });
</script>
