const { name, class: className = "size-[18px]" } = Astro.props;
const { viewBox, path } = icons[name];
/** The close mark is a stroked cross, not a filled silhouette. */
const stroked = name === "close";
---

<svg
  viewBox={viewBox}
  fill={stroked ? "none" : "currentColor"}
  stroke={stroked ? "currentColor" : undefined}
  stroke-width={stroked ? 2 : undefined}
  stroke-linecap={stroked ? "round" : undefined}
  aria-hidden="true"
  class={className}
>
  <path d={path}></path>
</svg>
