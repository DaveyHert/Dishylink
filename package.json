{
  "name": "dishylink",
  "productName": "Dishylink",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "daveyhert <daviehert@gmail.com>",
  "license": "MIT",
  "description": "An open-source desktop app to monitor the performance and health of your Starlink.",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "vite",
    "dev:electron": "node scripts/make-icon.mjs && ELECTRON=1 vite",
    "dev:electron:win": "cross-env ELECTRON=1 vite",
    "build": "tsc -b && vite build",
    "build:electron": "ELECTRON=1 vite build",
    "pack:mac": "rm -rf dist dist-electron release && tsc -b && ELECTRON=1 vite build && node scripts/make-icon.mjs && electron-builder --mac --publish never",
    "pack:win": "tsc -b && cross-env ELECTRON=1 vite build && electron-builder --win --publish never",
    "release:mac": "rm -rf dist dist-electron release && tsc -b && ELECTRON=1 vite build && node scripts/make-icon.mjs && electron-builder --mac --publish always",
    "release:win": "tsc -b && cross-env ELECTRON=1 vite build && electron-builder --win --publish always",
    "make:icon": "node scripts/make-icon.mjs",
    "dev:extension": "wxt",
    "build:extension": "wxt build",
    "build:extension:firefox": "wxt build -b firefox",
    "build:extension:edge": "wxt build -b edge",
    "zip:extension": "wxt zip",
    "zip:extension:firefox": "wxt zip -b firefox",
    "zip:extension:edge": "wxt zip -b edge",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "historian": "tsx collector/historian.mts",
    "seed:desktop": "node scripts/seed-desktop.mjs",
    "typecheck": "tsc -b",
    "typecheck:extension": "wxt prepare && tsc --noEmit -p extension/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.6.0",
    "@number-flow/react": "^0.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "radix-ui": "^1.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "satellite.js": "^7.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@wxt-dev/module-react": "^1.2.2",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "playwright": "^1.61.1",
    "playwright-core": "^1.53.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.1"
  }
}
